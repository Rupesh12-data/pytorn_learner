   "source": [
    "data loading from dataset like fashionminist"
   ]
  },
  {
   "cell_type": "raw",
   "id": "a34dd367-3b27-473b-af47-46aa809b7c91",
   "metadata": {},
   "source": [
    "#load pytorch\n",
    "import torch \n",
    "#create to own dataset\n",
    "from torch.utils.data import Dataset\n",
    "#import readymade dataset\n",
    "from torchvision import datasets\n",
    "#import image transformation tools\n",
    "from torchvision.transforms import v2\n",
    "#for visualization\n",
    "import seaborn\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "raw",
   "id": "5f119657-c27f-4b61-91ad-58a044565b1d",
   "metadata": {},
   "source": [
    "training_data = datasets.FashionMNIST(\n",
    "    root=\"data\",\n",
    "    train=True,\n",
    "    download=True,\n",
    "    transform=v2.Compose([v2.ToImage(), v2.ToDtype(torch.float32, scale=True)])\n",
    ")\n",
    "\n",
    "test_data = datasets.FashionMNIST(\n",
    "    root=\"data\",\n",
    "    train=False,\n",
    "    download=True,\n",
    "    transform=v2.Compose([v2.ToImage(), v2.ToDtype(torch.float32, scale=True)])\n",
    ")"
   ]
  },
